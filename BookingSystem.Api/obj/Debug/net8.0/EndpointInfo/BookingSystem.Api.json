  "components": {
    "schemas": {
      "Booking": {
        "required": [
          "purpose",
          "room",
          "user"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "roomId": {
            "type": "integer",
            "format": "int32"
          },
          "room": {
            "$ref": "#/components/schemas/Room"
          },
          "purpose": {
            "type": "string",
            "nullable": true
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "attendees": {
            "type": "integer",
            "format": "int32"
          },
          "isPreferredRoom": {
            "type": "boolean"
          },
          "isPurposeCompatible": {
            "type": "boolean"
          },
          "dayOfWeek": {
            "type": "integer",
            "format": "int32"
          },
          "hourOfDay": {
            "type": "integer",
            "format": "int32"
          },
          "month": {
            "type": "integer",
            "format": "int32"
          },
          "isWeekend": {
            "type": "boolean"
          },
          "capacityUtilization": {
            "type": "number",
            "format": "double"
          },
          "isPeakHour": {
            "type": "boolean"
          },
          "season": {
            "type": "integer",
            "format": "int32"
          },
          "totalPrice": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BookingStatus": {
        "enum": [
          0,
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      },
      "Room": {
        "required": [
          "capacity",
          "description",
          "hasProjector",
          "hasWhiteboard",
          "pricePerMinute",
          "roomType"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          },
          "roomType": {
            "type": "string",
            "nullable": true
          },
          "hasProjector": {
            "type": "boolean"
          },
          "hasWhiteboard": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "pricePerMinute": {
            "type": "number",
            "format": "double"
          },
          "bookings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Booking"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "User": {
        "required": [
          "email",
          "firstName",
          "lastName",
          "password",
          "phoneNumber"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "phoneNumber": {
            "type": "integer",
            "format": "int32"
          },
          "preferredRoomIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}